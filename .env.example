# Local PostgreSQL 17 connection string for the app role.
# The API reads it from user secrets (dotnet user-secrets set "ConnectionStrings:Postgres" ...), not from this file.
# This line is a sample only: replace the password and keep real values out of Git.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=apiplayground;Username=apiplayground;Password=local-only-change-me

# Optional local integration-test admin. Must target postgres and have CREATEDB.
# Migration tests create/drop only generated apg_mig_* databases.
APIPLAYGROUND_TEST_ADMIN_CONNECTION=Host=localhost;Port=5432;Database=postgres;Username=apiplayground_test;Password=local-only-change-me